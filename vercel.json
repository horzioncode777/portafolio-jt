{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node build-pages.cjs && node prepare-vercel.cjs",
  "outputDirectory": "vercel-public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/downloads/CV_Juan_Esteban_Torres_Delgado_ATS.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"CV_Juan_Esteban_Torres_Delgado_ATS.pdf\""
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
